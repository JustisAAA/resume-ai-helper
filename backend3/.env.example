# 简历面试AI助手 - Serverless 部署配置
# 复制为 .env

# ===== 运行模式 =====
SERVERLESS=false
NODE_ENV=development

# ===== 数据库（Serverless 必须用 PostgreSQL！）=====
# 本地开发用 SQLite:
DATABASE_URL=file:./dev.db
# 云函数用 PostgreSQL（取消注释）:
# DATABASE_URL=postgresql://user:pass@host:5432/resume_ai

# ===== 服务端口（本地开发用）=====
PORT=3002

# ===== JWT 认证密钥 =====
JWT_SECRET=change-this-to-a-random-string-in-production

# ===== CORS =====
CORS_ORIGIN=

# ===== 文件上传路径（云函数需改为 COS/S3 路径）=====
UPLOAD_PATH=./uploads

# ===== 腾讯元器 API =====
YUANQI_BASE_URL=https://yuanqi.tencent.com/openapi/v1
YUANQI_APPID=
YUANQI_APPKEY=
YUANQI_ENTERPRISE_APPID=
YUANQI_ENTERPRISE_APPKEY=

# ===== 硅基流动 API（备用）=====
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
