# 简历面试AI助手 - 部署配置
# 复制为 .env 并修改

# ===== 服务端口 =====
PORT=3002
NODE_ENV=production

# ===== JWT 认证（必须修改！）=====
JWT_SECRET=your-super-secret-key-change-this-in-production

# ===== CORS（允许跨域来源，逗号分隔，留空则允许全部）=====
CORS_ORIGIN=

# ===== 腾讯元器 API（AI 面试评分）=====
YUANQI_BASE_URL=https://yuanqi.tencent.com/openapi/v1
YUANQI_APPID=
YUANQI_APPKEY=
YUANQI_ENTERPRISE_APPID=
YUANQI_ENTERPRISE_APPKEY=

# ===== 硅基流动 API（备用 AI）=====
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
