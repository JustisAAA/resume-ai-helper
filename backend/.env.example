# 服务器配置
PORT=3002
NODE_ENV=development

# 数据库配置（SQLite，轻量级）
DATABASE_URL="file:./dev.db"

# JWT 密钥（生产环境请更换，使用强随机字符串）
JWT_SECRET=your-jwt-secret-here-change-in-production

# 前端地址（用于 CORS）
FRONTEND_URL=http://localhost:5173

# 腾讯元器 API 配置（请填写你自己的 API Key）
# TENCENT_YUANQI_API_KEY=your-api-key-here
# TENCENT_YUANQI_API_URL=https://hunyuanapi.tencentcloudapi.com
