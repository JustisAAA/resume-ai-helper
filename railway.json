{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd backend3 && npm run railway:build && cd ../frontend && npm install && VITE_API_URL=/ npm run build",
    "watchPatterns": ["backend3/**", "frontend/**"]
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "startCommand": "cd backend3 && npm run railway:start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30
  }
}
